---
import { site } from '../data/site';
import { lien } from '../lib/urls';

const onglets = [
  { label: 'Accueil', chemin: '/' },
  { label: 'Réalisations', chemin: '/projets/' },
  { label: 'E5', chemin: '/e5/' },
  { label: 'Veille', chemin: '/veille/' },
  { label: 'À propos', chemin: '/a-propos/' },
];

// On compare des chemins sans le base, pour que la navigation reste active
// que le site soit à la racine ou sous un sous-chemin.
const racine = import.meta.env.BASE_URL.replace(/\/$/, '');
const cheminActuel =
  Astro.url.pathname.slice(racine.length).replace(/index\.html$/, '').replace(/\/$/, '') || '/';

function estActif(chemin: string) {
  return chemin === '/' ? cheminActuel === '/' : cheminActuel.startsWith(chemin.replace(/\/$/, ''));
}
---

<header class="entete" data-entete>
  <div class="conteneur entete-interne">
    <a class="marque" href={lien('/')}>
      <span class="marque-nom">{site.nom}</span>
      <span class="marque-role">BTS SIO · SLAM</span>
    </a>

    <button
      class="menu-bouton"
      type="button"
      aria-expanded="false"
      aria-controls="menu-principal"
      data-menu-bouton
    >
      <span class="sr-only">Ouvrir le menu</span>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18"></path>
      </svg>
    </button>

    <nav id="menu-principal" aria-label="Navigation principale">
      <ul class="onglets">
        {
          onglets.map((onglet) => (
            <li>
              <a href={lien(onglet.chemin)} aria-current={estActif(onglet.chemin) ? 'page' : undefined}>
                {onglet.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      class="bascule-theme"
      type="button"
      aria-label="Basculer le thème clair / sombre"
      data-bascule-theme
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" aria-hidden="true" data-icone="lune">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" aria-hidden="true" data-icone="soleil">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
    </button>
  </div>
</header>

<style>
  .entete {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--fond) 88%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--bordure);
  }

  .entete-interne {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 4rem;
  }

  .marque {
    display: flex;
    flex-direction: column;
    margin-right: auto;
    line-height: 1.25;
  }

  .marque-nom {
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .marque-role {
    font-family: var(--police-mono);
    font-size: 0.68rem;
    color: var(--texte-3);
  }

  .onglets {
    display: flex;
    gap: 0.1rem;
    list-style: none;
    padding: 0;
  }

  .onglets a {
    display: block;
    padding: 0.4rem 0.65rem;
    font-size: 0.88rem;
    color: var(--texte-2);
    border-radius: var(--r-s);
    transition: color var(--transition), background var(--transition);
  }

  .onglets a:hover {
    color: var(--texte);
    background: var(--fond-3);
  }

  .onglets a[aria-current='page'] {
    color: var(--texte);
    font-weight: 600;
    background: var(--fond-3);
  }

  .bascule-theme,
  .menu-bouton {
    display: grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    color: var(--texte-2);
    background: var(--fond-2);
    border: 1px solid var(--bordure);
    border-radius: var(--r-s);
    cursor: pointer;
    transition: color var(--transition), border-color var(--transition);
  }

  .bascule-theme {
    margin-left: 0.25rem;
  }

  .menu-bouton {
    display: none;
  }

  .bascule-theme:hover,
  .menu-bouton:hover {
    color: var(--accent);
    border-color: var(--bordure-forte);
  }

  /* L'attribut hidden n'est pas appliqué de façon fiable aux SVG selon les
     navigateurs : on force le masquage de l'icône inactive. La règle par
     thème évite aussi un flash des deux icônes avant l'exécution du script. */
  html[data-theme='sombre'] .bascule-theme [data-icone='soleil'],
  html[data-theme='clair'] .bascule-theme [data-icone='lune'] {
    display: none;
  }

  html[data-theme='sombre'] .bascule-theme [data-icone='lune'],
  html[data-theme='clair'] .bascule-theme [data-icone='soleil'] {
    display: block;
  }

  @media (max-width: 48rem) {
    .menu-bouton {
      display: grid;
    }

    .entete nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: none;
      padding: 0.6rem 1.5rem 1rem;
      background: var(--fond-2);
      border-bottom: 1px solid var(--bordure);
    }

    .entete[data-ouvert='true'] nav {
      display: block;
    }

    .onglets {
      flex-direction: column;
      gap: 0.15rem;
    }

    .onglets a {
      padding: 0.6rem 0.75rem;
      font-size: 0.95rem;
    }
  }

  @media (max-width: 30rem) {
    .marque-role {
      display: none;
    }
  }
</style>

<script>
  const entete = document.querySelector<HTMLElement>('[data-entete]');
  const boutonMenu = document.querySelector<HTMLButtonElement>('[data-menu-bouton]');
  const lienMenu = document.querySelectorAll<HTMLAnchorElement>('#menu-principal a');
  const boutonTheme = document.querySelector<HTMLButtonElement>('[data-bascule-theme]');

  function ouvrirMenu(ouvert: boolean) {
    if (!entete || !boutonMenu) return;
    entete.dataset.ouvert = String(ouvert);
    boutonMenu.setAttribute('aria-expanded', String(ouvert));
    const libelle = boutonMenu.querySelector('.sr-only');
    if (libelle) libelle.textContent = ouvert ? 'Fermer le menu' : 'Ouvrir le menu';
  }

  boutonMenu?.addEventListener('click', () => {
    ouvrirMenu(entete?.dataset.ouvert !== 'true');
  });

  lienMenu.forEach((lien) => lien.addEventListener('click', () => ouvrirMenu(false)));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') ouvrirMenu(false);
  });

  function majIcones() {
    const clair = document.documentElement.dataset.theme === 'clair';
    document
      .querySelectorAll<SVGElement>('[data-icone]')
      .forEach((svg) => svg.toggleAttribute('hidden', svg.dataset.icone === (clair ? 'lune' : 'soleil')));
  }

  majIcones();
  boutonTheme?.addEventListener('click', () => {
    const suivant = document.documentElement.dataset.theme === 'clair' ? 'sombre' : 'clair';
    document.documentElement.dataset.theme = suivant;
    localStorage.setItem('theme', suivant);
    majIcones();
  });
</script>
