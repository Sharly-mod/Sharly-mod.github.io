---
import { site } from '../data/site';
import { lien } from '../lib/urls';

const onglet = ['Accueil', 'Projets', 'Veille', 'À propos'];
const chemins: Record<string, string> = {
  Accueil: '/',
  Projets: '/projets/',
  Veille: '/veille/',
  'À propos': '/a-propos/',
};

// On compare des chemins sans le base, pour que la navigation reste active
// que le site soit à la racine ou sous un sous-chemin.
const racine = import.meta.env.BASE_URL.replace(/\/$/, '');
const cheminActuel =
  Astro.url.pathname.slice(racine.length).replace(/index\.html$/, '').replace(/\/$/, '') || '/';
function estActif(onglet: string) {
  const c = chemins[onglet];
  return c === '/' ? cheminActuel === '/' : cheminActuel.startsWith(c.replace(/\/$/, ''));
}
---

<header class="entete">
  <div class="conteneur entete-interne">
    <a class="marque" href={lien('/')}>
      <span class="marque-nom">{site.nom}</span>
      <span class="marque-role">Dev web & game systems</span>
    </a>

    <nav aria-label="Navigation principale">
      <ul class="onglets">
        {
          onglet.map((o) => (
            <li>
              <a href={lien(chemins[o])} aria-current={estActif(o) ? 'page' : undefined}>
                {o}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      class="bascule-theme"
      type="button"
      aria-label="Basculer le thème clair / sombre"
      data-bascule-theme
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" aria-hidden="true" data-icone="lune">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" aria-hidden="true" data-icone="soleil">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
    </button>
  </div>
</header>

<style>
  .entete {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--fond) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.6);
    border-bottom: 1px solid var(--bordure);
  }

  .entete-interne {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4rem;
  }

  .marque {
    display: flex;
    flex-direction: column;
    margin-right: auto;
    line-height: 1.25;
  }

  .marque-nom {
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .marque-role {
    font-family: var(--police-mono);
    font-size: 0.7rem;
    color: var(--texte-3);
  }

  .onglets {
    display: flex;
    gap: 0.15rem;
    list-style: none;
    padding: 0;
  }

  .onglets a {
    display: block;
    padding: 0.4rem 0.7rem;
    font-size: 0.9rem;
    color: var(--texte-2);
    border-radius: var(--r-s);
    transition: color var(--transition), background var(--transition);
  }

  .onglets a:hover {
    color: var(--texte);
    background: var(--fond-3);
  }

  .onglets a[aria-current='page'] {
    color: var(--texte);
    font-weight: 550;
  }

  .bascule-theme {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    margin-left: 0.5rem;
    color: var(--texte-2);
    background: var(--fond-3);
    border: 1px solid var(--bordure);
    border-radius: var(--r-s);
    cursor: pointer;
    transition: color var(--transition), border-color var(--transition);
  }

  .bascule-theme:hover {
    color: var(--violet);
    border-color: var(--bordure-forte);
  }

  @media (max-width: 30rem) {
    .marque-role {
      display: none;
    }

    .onglets a {
      padding-inline: 0.5rem;
      font-size: 0.85rem;
    }
  }
</style>

<script>
  const bouton = document.querySelector<HTMLButtonElement>('[data-bascule-theme]');

  function majIcones() {
    const clair = document.documentElement.dataset.theme === 'clair';
    document
      .querySelectorAll<SVGElement>('[data-icone]')
      .forEach((svg) => svg.toggleAttribute('hidden', svg.dataset.icone === (clair ? 'lune' : 'soleil')));
  }

  majIcones();
  bouton?.addEventListener('click', () => {
    const suivant = document.documentElement.dataset.theme === 'clair' ? 'sombre' : 'clair';
    document.documentElement.dataset.theme = suivant;
    localStorage.setItem('theme', suivant);
    majIcones();
  });
</script>
