---
import type { CollectionEntry } from 'astro:content';
import { lien } from '../lib/urls';
import { libelleContexte, tonContexte } from '../lib/libelles';

interface Props {
  projet: CollectionEntry<'projets'>;
  compact?: boolean;
}

const { projet, compact = false } = Astro.props;
const d = projet.data;
const url = lien(`/projets/${projet.id}/`);
---

<a
  class:list={['carte', 'carte-projet', { compact }]}
  href={url}
  data-ton={d.couleur}
  data-categorie={d.contexte}
>
  <div class="carte-haut">
    <span class="etiquette" data-ton={tonContexte(projet)}>{libelleContexte(projet)}</span>
    <span class="carte-statut">
      {d.statut !== 'termine' && <span class="badge badge-statut">{d.statut.replace('-', ' ')}</span>}
      <span class="annee">{d.annee}</span>
    </span>
  </div>

  <div class="carte-titre">
    <h3>{d.titre}</h3>
    {d.selectionE5 && <span class="badge badge-e5">Fiche E5</span>}
  </div>

  <p>{d.resume}</p>

  <ul class="pastilles">
    {d.stack.slice(0, compact ? 4 : 6).map((t) => <li class="pastille">{t}</li>)}
  </ul>

  <div class="pied">
    <span class="lien-fleche">Voir la fiche</span>
  </div>
</a>

<style>
  .carte-projet {
    gap: 0.8rem;
  }

  .carte-haut {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .carte-titre {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .carte-titre h3 {
    transition: color var(--transition);
  }

  a.carte-projet:hover h3 {
    color: var(--accent);
  }

  .badge-e5 {
    flex: 0 0 auto;
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 35%, var(--bordure));
    background: color-mix(in srgb, var(--accent) 7%, var(--fond-2));
  }

  .carte-statut {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .badge-statut {
    color: var(--ambre);
    border-color: color-mix(in srgb, var(--ambre) 35%, var(--bordure));
    background: color-mix(in srgb, var(--ambre) 8%, var(--fond-2));
  }

  .annee {
    font-family: var(--police-mono);
    font-size: 0.72rem;
    color: var(--texte-3);
    white-space: nowrap;
  }

  .pied {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.35rem;
  }

  .carte-projet.compact {
    padding: 1.1rem;
  }

  .carte-projet.compact h3 {
    font-size: 1rem;
  }

  .carte-projet.compact .badge-e5 {
    display: none;
  }

  @media (max-width: 36rem) {
    .pied .annee {
      display: none;
    }
  }
</style>
