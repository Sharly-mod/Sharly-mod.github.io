---
import type { CollectionEntry } from 'astro:content';
import { lien } from '../lib/urls';

interface Props {
  projet: CollectionEntry<'projets'>;
  compact?: boolean;
}

const { projet, compact = false } = Astro.props;
const d = projet.data;
const url = lien(`/projets/${projet.id}/`);
---

<a class="carte" href={url} data-ton={d.couleur}>
  {!compact && d.image && (
    <img class="vignette" src={d.image} alt="" loading="lazy" decoding="async" width="800" height="450" />
  )}

  <div class="entete">
    <h3>{d.titre}</h3>
    <span class="etiquette">{d.contexte}</span>
  </div>

  <p>{d.resume}</p>

  <ul class="pastilles">
    {d.stack.slice(0, compact ? 4 : 6).map((t) => <li class="pastille">{t}</li>)}
  </ul>

  <div class="pied">
    <span class="lien-fleche">Voir le projet</span>
    <span class="annee">{d.annee}</span>
  </div>
</a>

<style>
  .vignette {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--r-s);
    border: 1px solid var(--bordure);
  }

  .entete {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .entete h3 {
    transition: color var(--transition);
  }

  a.carte:hover h3 {
    color: var(--accent, var(--violet));
  }

  .carte[data-ton='cyan'] { --accent: var(--cyan); }
  .carte[data-ton='ambre'] { --accent: var(--ambre); }
  .carte[data-ton='vert'] { --accent: var(--vert); }
  .carte[data-ton='violet'] { --accent: var(--violet); }

  .pied {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.35rem;
  }

  .annee {
    font-family: var(--police-mono);
    font-size: 0.75rem;
    color: var(--texte-3);
  }
</style>
