---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { lien } from '../../lib/urls';
import { formatDate } from '../../lib/libelles';

const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const flux = (await getCollection('veille'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 60);

const nomCategories: Record<string, string> = {
  'ia-jv': 'IA & jeu vidéo',
  moteurs: 'Moteurs & rendu',
  recherche: 'Recherche',
  web: 'Web & outillage',
  infra: 'Infrastructure',
  metiers: 'Métiers du jeu',
};

const nomCouleurs: Record<string, string> = {
  'ia-jv': 'violet',
  moteurs: 'ambre',
  recherche: 'cyan',
  web: 'vert',
  infra: 'cyan',
  metiers: 'vert',
};
---

<Base
  titre="Archives de veille"
  description="Archives de l'ancienne veille technologique sur l'IA appliquée au jeu vidéo, conservées pour mémoire."
>
  <section class="entete-page">
    <div class="conteneur">
      <span class="surtitre">Archives</span>
      <h1>Ancienne veille IA & jeu vidéo</h1>
      <p class="legende">
        Cette veille a précédé le sujet actuel sur la sécurité de la chaîne
        logistique logicielle. Elle est conservée pour garder une trace du
        travail et des notes d’analyse, mais elle n’est plus le sujet principal
        présenté à l’oral.
      </p>
      <a class="bouton secondaire" href={lien('/veille/')}>Revenir à la veille E5</a>
    </div>
  </section>

  <div class="conteneur corps">
    <section class="bloc">
      <div class="entete-section">
        <div>
          <span class="surtitre">Notes personnelles</span>
          <h2>Notes d’analyse</h2>
        </div>
        <p class="legende">{notes.length} notes écrites à la main.</p>
      </div>

      <div class="grille">
        {
          notes.map((note) => (
            <a class="article" href={lien(`/veille/note/${note.id}/`)}>
              <div class="meta">
                <span class="pastille" data-ton={nomCouleurs[note.data.categories[0]] ?? 'violet'}>
                  {nomCategories[note.data.categories[0]] ?? note.data.categories[0]}
                </span>
                <span>{formatDate(note.data.date)}</span>
              </div>
              <h3>{note.data.titre}</h3>
              <p>{note.data.source} — note d’analyse complète.</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="bloc">
      <div class="entete-section">
        <div>
          <span class="surtitre">Flux collecté</span>
          <h2>Derniers articles suivis</h2>
        </div>
        <p class="legende">
          Les 60 entrées les plus récentes, conservées comme archive brute.
        </p>
      </div>

      <div class="flux-liste">
        {
          flux.map((article) => (
            <a class="flux-item" href={article.data.url} target="_blank" rel="noopener noreferrer">
              <span class="flux-source">{article.data.source}</span>
              <span class="flux-titre">{article.data.titre}</span>
              <span class="flux-date">{formatDate(article.data.date)}</span>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</Base>

<style>
  .entete-page {
    padding-block: clamp(3rem, 8vw, 5rem) clamp(1.5rem, 4vw, 2.5rem);
  }

  .entete-page h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.035em;
  }

  .entete-page .legende {
    max-width: 68ch;
    margin-top: 1rem;
    margin-bottom: 1.25rem;
  }

  .corps {
    padding-bottom: 4rem;
  }

  .bloc + .bloc {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--bordure);
  }

  .flux-liste {
    display: grid;
    gap: 0.35rem;
  }

  .flux-item {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr) 7rem;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.65rem 0.75rem;
    border: 1px solid transparent;
    border-bottom-color: var(--bordure);
    transition: background var(--transition), border-color var(--transition);
  }

  .flux-item:hover {
    background: var(--fond-2);
    border-color: var(--bordure);
    border-radius: var(--r-s);
  }

  .flux-source,
  .flux-date {
    font-family: var(--police-mono);
    font-size: 0.7rem;
    color: var(--texte-3);
  }

  .flux-titre {
    font-size: 0.9rem;
    color: var(--texte-2);
  }

  @media (max-width: 44rem) {
    .flux-item {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }

    .flux-date {
      order: -1;
    }
  }
</style>
