---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icone from '../../components/Icone.astro';
import { lien } from '../../lib/urls';
import { formatDate } from '../../lib/libelles';

const syntheses = (await getCollection('veilleE5')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const methodes = [
  {
    titre: 'Collecter',
    texte:
      'Flux RSS centralisés dans Feedly, GitHub Trending et releases des outils que j’utilise, alertes CERT-FR / ANSSI.',
  },
  {
    titre: 'Trier',
    texte:
      'Je ne garde que ce qui change une pratique : une faille exploitable, une recommandation officielle, un retour d’expérience reproductible.',
  },
  {
    titre: 'Synthétiser',
    texte:
      'Une fiche par sujet : source, résumé, impact concret pour un développeur SLAM, limites de ce que j’ai compris.',
  },
  {
    titre: 'Relier au projet',
    texte:
      'Chaque synthèse est reliée à un projet ou à une pratique : dépendances npm, PDO, CI/CD, secrets, revue de code.',
  },
];

const outils = [
  'Feedly / flux RSS',
  'GitHub Trending & releases',
  'Documentation officielle (OWASP, npm, PHP)',
  'CERT-FR / ANSSI',
  'Newsletters cybersécurité',
  'Communautés de développeurs',
];
---

<Base
  titre="Veille technologique"
  description="Veille sur la sécurité de la chaîne logistique logicielle (OWASP Top 10) et l’impact des outils d’IA sur le développement, avec méthode et synthèses datées."
>
  <section class="entete-page">
    <div class="conteneur">
      <span class="surtitre">Veille technologique</span>
      <h1>Sécurité de la chaîne logistique logicielle & IA</h1>
      <p class="legende">
        Une veille hebdomadaire, pas un flux d’actualités. Je sélectionne, je
        lis, je synthétise et je regarde ce que cela change concrètement dans
        mes projets. Le sujet principal : les dépendances, les pipelines et les
        outils que l’on utilise sans les connaître.
      </p>
      <div class="veille-sujet">
        <div>
          <span class="surtitre">Sujet 2026</span>
          <p>
            <strong>Software Supply Chain Security</strong> (OWASP Top 10:2025)
            et <strong>impact des outils d’IA</strong> sur le développement.
          </p>
        </div>
        <span class="badge">{syntheses.length} synthèses publiées</span>
      </div>
    </div>
  </section>

  <div class="conteneur corps">
    <section class="bloc" id="methode">
      <div class="entete-section">
        <div>
          <span class="surtitre">Méthode</span>
          <h2>Comment je fais ma veille</h2>
        </div>
        <p class="legende">
          Environ 30 minutes par semaine, avec une trace écrite de ce que j’ai
          retenu.
        </p>
      </div>

      <ol class="methode-veille">
        {
          methodes.map((etape, index) => (
            <li>
              <span class="methode-numero">{String(index + 1).padStart(2, '0')}</span>
              <h3>{etape.titre}</h3>
              <p>{etape.texte}</p>
            </li>
          ))
        }
      </ol>

      <div class="outils">
        <span class="outils-titre">Outils & sources</span>
        <ul class="pastilles">
          {outils.map((outil) => <li class="pastille">{outil}</li>)}
        </ul>
      </div>
    </section>

    <section class="bloc" id="syntheses">
      <div class="entete-section">
        <div>
          <span class="surtitre">Synthèses</span>
          <h2>Trois fiches datées</h2>
        </div>
        <p class="legende">
          Chaque fiche contient la source, un résumé et l’impact pour un
          développeur SLAM.
        </p>
      </div>

      <div class="syntheses-grille">
        {
          syntheses.map((note) => (
            <article class="synthese">
              <div class="synthese-meta">
                <span class="badge">{note.data.source}</span>
                <time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time>
                <span>{note.data.tempsLecture} min</span>
              </div>
              <h3>
                <a href={lien(`/veille/${note.id}/`)}>{note.data.titre}</a>
              </h3>
              <p>{note.data.resume}</p>
              <div class="impact-veille">
                <strong>Impact pour un développeur SLAM</strong>
                <p>{note.data.impact}</p>
              </div>
              <a class="lien-fleche" href={lien(`/veille/${note.id}/`)}>Lire la synthèse</a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="bloc" id="sources">
      <div class="entete-section">
        <div>
          <span class="surtitre">Sources</span>
          <h2>Ce que je suis</h2>
        </div>
      </div>
      <div class="sources-grille">
        <div class="source-bloc">
          <h3>Sécurité logicielle</h3>
          <ul>
            <li><a class="lien-externe" href="https://owasp.org/Top10/" target="_blank" rel="noopener noreferrer">OWASP Top 10 ↗</a></li>
            <li><a class="lien-externe" href="https://www.cert.ssi.gouv.fr/" target="_blank" rel="noopener noreferrer">CERT-FR / ANSSI ↗</a></li>
            <li><a class="lien-externe" href="https://github.blog/security/" target="_blank" rel="noopener noreferrer">GitHub Security Lab ↗</a></li>
          </ul>
        </div>
        <div class="source-bloc">
          <h3>Développement & IA</h3>
          <ul>
            <li><a class="lien-externe" href="https://docs.npmjs.com/" target="_blank" rel="noopener noreferrer">Documentation npm ↗</a></li>
            <li><a class="lien-externe" href="https://www.php.net/manual/fr/" target="_blank" rel="noopener noreferrer">Documentation PHP ↗</a></li>
            <li><a class="lien-externe" href="https://github.blog/" target="_blank" rel="noopener noreferrer">GitHub Blog ↗</a></li>
          </ul>
        </div>
      </div>

      <p class="archive">
        <Icone nom="file" taille={15} />
        Ancienne veille IA & jeu vidéo conservée pour mémoire :
        <a class="lien-externe" href={lien('/veille/archives/')}>consulter les archives</a>.
      </p>
    </section>
  </div>
</Base>

<style>
  .entete-page {
    padding-block: clamp(3rem, 8vw, 5rem) clamp(1.5rem, 4vw, 2.5rem);
  }

  .entete-page h1 {
    max-width: 24ch;
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.035em;
  }

  .entete-page .legende {
    max-width: 70ch;
    margin-top: 1rem;
  }

  .veille-sujet {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
    padding: 1rem 1.1rem;
    background: var(--fond-2);
    border: 1px solid var(--bordure);
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--r-m) var(--r-m) 0;
  }

  .veille-sujet p {
    font-size: 0.92rem;
    color: var(--texte-2);
  }

  .corps {
    padding-bottom: 4rem;
  }

  .bloc + .bloc {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--bordure);
  }

  .methode-veille {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    list-style: none;
    padding: 0;
  }

  .methode-veille li {
    padding: 1.1rem;
    background: var(--fond-2);
    border: 1px solid var(--bordure);
    border-radius: var(--r-m);
  }

  .methode-numero {
    display: block;
    margin-bottom: 0.45rem;
    font-family: var(--police-mono);
    font-size: 0.72rem;
    color: var(--accent);
  }

  .methode-veille h3 {
    font-size: 1rem;
  }

  .methode-veille p {
    margin-top: 0.35rem;
    font-size: 0.86rem;
    color: var(--texte-2);
  }

  .outils {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 1rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--bordure);
  }

  .outils-titre {
    font-family: var(--police-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--texte-3);
  }

  .syntheses-grille {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  .synthese {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1.25rem;
    background: var(--fond-2);
    border: 1px solid var(--bordure);
    border-radius: var(--r-m);
  }

  .synthese h3 {
    font-size: 1.05rem;
    line-height: 1.35;
  }

  .synthese h3 a:hover {
    color: var(--accent);
  }

  .synthese > p {
    font-size: 0.88rem;
    color: var(--texte-2);
  }

  .synthese-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.7rem;
    font-family: var(--police-mono);
    font-size: 0.7rem;
    color: var(--texte-3);
  }

  .synthese .lien-fleche {
    margin-top: auto;
  }

  .sources-grille {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .source-bloc {
    padding: 1.1rem;
    background: var(--fond-2);
    border: 1px solid var(--bordure);
    border-radius: var(--r-m);
  }

  .source-bloc h3 {
    font-size: 0.98rem;
  }

  .source-bloc ul {
    display: grid;
    gap: 0.4rem;
    margin-top: 0.6rem;
    list-style: none;
    padding: 0;
    font-size: 0.88rem;
  }

  .archive {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.5rem;
    font-size: 0.85rem;
    color: var(--texte-3);
  }
</style>
