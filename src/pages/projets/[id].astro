---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icone from '../../components/Icone.astro';
import { blocsBts, tonsBts } from '../../data/competences-bts';
import { lien } from '../../lib/urls';
import { libelleContexte } from '../../lib/libelles';

export async function getStaticPaths() {
  const projets = await getCollection('projets');
  return projets.map((projet) => ({
    params: { id: projet.id },
    props: { projet },
  }));
}

const { projet } = Astro.props;
const { Content } = await render(projet);
const d = projet.data;

const statuts: Record<string, string> = {
  termine: 'Terminé',
  'en-cours': 'En cours',
  prototype: 'Prototype',
  production: 'En production',
};

const blocsCouverts = blocsBts.filter((bloc) => d.competencesBts.includes(bloc.code));
const capturesACompleter = d.aCompleter.filter((item) => /capture|aperçu|maquette|mcd|mld/i.test(item));
const placeholders = capturesACompleter.length > 0 ? capturesACompleter : d.aCompleter;
---

<Base titre={d.titre} description={d.resume}>
  <article class="conteneur">
    <nav class="fil" aria-label="Fil d'Ariane">
      <a href={lien('/projets/')}>Réalisations</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{d.titre}</span>
    </nav>

    <header class="entete-fiche">
      <div class="entete-texte">
        <div class="etiquettes">
          <span class="etiquette">{libelleContexte(projet)}</span>
          <span class="etiquette">{d.annee}</span>
          <span class="etiquette">{statuts[d.statut] ?? d.statut}</span>
          {d.selectionE5 && <span class="badge badge-e5">Fiche E5</span>}
        </div>
        <h1>{d.titre}</h1>
        <p class="resume">{d.resume}</p>
        <p class="role-ligne"><strong>Rôle :</strong> {d.role}</p>
      </div>
    </header>

    <div class="grille-page">
      <div class="contenu-principal">
        {
          d.besoins.length > 0 && (
            <section class="bloc-fiche">
              <h2>Contexte & besoins</h2>
              <ul class="liste-fiche">
                {d.besoins.map((besoin) => <li>{besoin}</li>)}
              </ul>
            </section>
          )
        }

        {
          d.choixTechniques.length > 0 && (
            <section class="bloc-fiche">
              <h2>Choix techniques</h2>
              <ul class="liste-fiche">
                {d.choixTechniques.map((choix) => <li>{choix}</li>)}
              </ul>
            </section>
          )
        }

        {
          (d.fonctionnalites.length > 0 || d.crud.length > 0) && (
            <section class="bloc-fiche">
              <h2>Fonctionnalités & opérations CRUD</h2>
              <div class="deux-colonnes">
                {d.fonctionnalites.length > 0 && (
                  <div>
                    <h3>Fonctionnalités</h3>
                    <ul class="liste-fiche">
                      {d.fonctionnalites.map((item) => <li>{item}</li>)}
                    </ul>
                  </div>
                )}
                {d.crud.length > 0 && (
                  <div>
                    <h3>CRUD</h3>
                    <ul class="liste-fiche">
                      {d.crud.map((item) => <li>{item}</li>)}
                    </ul>
                  </div>
                )}
              </div>
            </section>
          )
        }

        {
          d.securite.length > 0 && (
            <section class="bloc-fiche">
              <h2>Sécurité & bonnes pratiques</h2>
              <ul class="liste-fiche liste-securite">
                {d.securite.map((item) => <li>{item}</li>)}
              </ul>
            </section>
          )
        }

        {
          blocsCouverts.length > 0 && (
            <section class="bloc-fiche">
              <h2>Compétences BTS SIO mobilisées</h2>
              <ul class="pastilles competences-bts">
                {blocsCouverts.map((bloc) => (
                  <li>
                    <a class="pastille" data-ton={tonsBts[bloc.code]} href={lien(`/e5/#${bloc.code}`)}>
                      {bloc.code} · {bloc.titre}
                    </a>
                  </li>
                ))}
              </ul>
              <p class="legende">
                {d.selectionE5 ? (
                  <>
                    Correspondance détaillée dans le{' '}
                    <a class="lien-externe" href={lien('/e5/')}>tableau de synthèse E5</a>.
                  </>
                ) : (
                  <>
                    Projet complémentaire : ces compétences ne sont pas comptées
                    dans le tableau de synthèse E5.
                  </>
                )}
              </p>
            </section>
          )
        }

        {
          d.captures.length > 0 ? (
            <section class="bloc-fiche">
              <h2>Captures & preuves</h2>
              <div class="captures-grille">
                {d.captures.map((capture, index) => (
                  <figure class="capture">
                    <img src={capture} alt={`${d.titre} — capture ${index + 1}`} loading="lazy" />
                  </figure>
                ))}
              </div>
            </section>
          ) : placeholders.length > 0 ? (
            <section class="bloc-fiche">
              <h2>Captures & preuves</h2>
              <div class="captures-grille">
                {placeholders.map((item) => (
                  <div class="capture-placeholder">
                    <span class="badge" data-statut="manquant">À compléter</span>
                    <p>{item}</p>
                  </div>
                ))}
              </div>
            </section>
          ) : null
        }

        <section class="bloc-fiche">
          <h2>Retour d’expérience</h2>
          <div class="prose">
            <Content />
          </div>
        </section>
      </div>

      <aside class="colonne">
        <section class="encart">
          <h2>Rôle</h2>
          <p>{d.role}</p>
        </section>

        <section class="encart">
          <h2>Période</h2>
          <p>{d.annee} · {statuts[d.statut] ?? d.statut}</p>
        </section>

        {
          d.stack.length > 0 && (
            <section class="encart">
              <h2>Stack</h2>
              <ul class="pastilles">
                {d.stack.map((techno) => <li class="pastille">{techno}</li>)}
              </ul>
            </section>
          )
        }

        {
          d.competences.length > 0 && (
            <section class="encart">
              <h2>Compétences techniques</h2>
              <ul>
                {d.competences.map((competence) => <li>{competence}</li>)}
              </ul>
            </section>
          )
        }

        {
          (d.repo || d.demo || d.liens.length > 0) && (
            <section class="encart">
              <h2>Liens</h2>
              <ul>
                {d.repo && (
                  <li>
                    <a class="lien-externe" href={d.repo} target="_blank" rel="noopener noreferrer">
                      Code source ↗
                    </a>
                  </li>
                )}
                {d.demo && (
                  <li>
                    <a class="lien-externe" href={d.demo} target="_blank" rel="noopener noreferrer">
                      Version en ligne ↗
                    </a>
                  </li>
                )}
                {d.liens.map((lienExterne) => (
                  <li>
                    <a class="lien-externe" href={lienExterne.url} target="_blank" rel="noopener noreferrer">
                      {lienExterne.label} ↗
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          d.aCompleter.length > 0 && (
            <section class="encart encart-a-completer">
              <h2>À compléter</h2>
              <ul>
                {d.aCompleter.map((item) => <li>{item}</li>)}
              </ul>
            </section>
          )
        }

        <a class="bouton secondaire bouton-retour" href={lien('/projets/')}>
          <Icone nom="fleche" taille={15} />
          Toutes les réalisations
        </a>
      </aside>
    </div>
  </article>
</Base>

<style>
  .fil {
    display: flex;
    gap: 0.5rem;
    padding-block: 2rem 1.5rem;
    font-size: 0.85rem;
    color: var(--texte-3);
  }

  .fil a:hover {
    color: var(--accent);
  }

  .entete-fiche {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--bordure);
  }

  .etiquettes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .badge-e5 {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 35%, var(--bordure));
    background: color-mix(in srgb, var(--accent) 7%, var(--fond-2));
  }

  .entete-fiche h1 {
    max-width: 24ch;
    margin-top: 0.9rem;
    font-size: clamp(1.9rem, 5vw, 3rem);
    letter-spacing: -0.035em;
  }

  .resume {
    max-width: 68ch;
    margin-top: 0.9rem;
    font-size: 1.05rem;
    color: var(--texte-2);
  }

  .role-ligne {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--texte-3);
  }

  .role-ligne strong {
    color: var(--texte-2);
    font-weight: 600;
  }

  .grille-page {
    display: grid;
    gap: 3rem;
    padding-block: 2.5rem 4rem;
  }

  @media (min-width: 64rem) {
    .grille-page {
      grid-template-columns: minmax(0, 1fr) 18rem;
      align-items: start;
    }
  }

  .contenu-principal {
    min-width: 0;
  }

  .bloc-fiche + .bloc-fiche {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--bordure);
  }

  .bloc-fiche h2 {
    margin-bottom: 0.9rem;
    font-size: 1.3rem;
  }

  .bloc-fiche h3 {
    margin-bottom: 0.6rem;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .liste-fiche {
    display: grid;
    gap: 0.5rem;
    padding-left: 1.15rem;
    color: var(--texte-2);
    font-size: 0.94rem;
  }

  .liste-fiche li::marker {
    color: var(--accent);
  }

  .liste-securite li::marker {
    color: var(--vert);
  }

  .deux-colonnes {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 46rem) {
    .deux-colonnes {
      grid-template-columns: 1fr 1fr;
    }
  }

  .competences-bts {
    margin-bottom: 0.75rem;
  }

  .competences-bts .pastille {
    white-space: normal;
  }

  .captures-grille {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .capture {
    margin: 0;
    overflow: hidden;
    background: var(--fond-2);
    border: 1px solid var(--bordure);
    border-radius: var(--r-m);
  }

  .capture img {
    width: 100%;
    height: auto;
  }

  .capture-placeholder {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    min-height: 8rem;
    padding: 1rem;
    background: var(--fond-2);
    border: 1px dashed var(--bordure-forte);
    border-radius: var(--r-m);
  }

  .capture-placeholder p {
    font-size: 0.84rem;
    color: var(--texte-3);
  }

  .colonne {
    display: grid;
    gap: 1rem;
    position: sticky;
    top: 5.5rem;
  }

  .encart-a-completer {
    border-color: color-mix(in srgb, var(--ambre) 35%, var(--bordure));
    background: color-mix(in srgb, var(--ambre) 5%, var(--fond-2));
  }

  .encart-a-completer h2 {
    color: var(--ambre);
  }

  .bouton-retour {
    justify-content: flex-start;
  }

  .bouton-retour svg {
    transform: rotate(180deg);
  }

  .prose {
    max-width: none;
  }

  @media (max-width: 63.99rem) {
    .colonne {
      position: static;
    }
  }
</style>
