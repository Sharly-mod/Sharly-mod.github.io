---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CarteProjet from '../../components/CarteProjet.astro';
import { lien } from '../../lib/urls';
import { categoriesFiltre } from '../../lib/libelles';

const tous = (await getCollection('projets')).sort((a, b) => a.data.ordre - b.data.ordre);
const realisations = tous.filter((p) => p.data.selectionE5);
const autres = tous.filter((p) => !p.data.selectionE5);

const compteurs: Record<string, number> = {
  tous: realisations.length,
  atelier: realisations.filter((p) => p.data.contexte === 'atelier').length,
  stage: realisations.filter((p) => p.data.contexte === 'stage').length,
  personnel: realisations.filter((p) => p.data.contexte === 'personnel').length,
};
---

<Base
  titre="Réalisations professionnelles"
  description="Les quatre réalisations présentées à l'épreuve E5 du BTS SIO SLAM : Fair'repair, stage GestioParc, plugin Java Champi-Hardcore et messagerie React/Supabase."
>
  <section class="entete-page">
    <div class="conteneur">
      <span class="surtitre">Réalisations professionnelles</span>
      <h1>Quatre projets, quatre contextes</h1>
      <p class="legende">
        Une plateforme web en PHP, une application de gestion de parc développée
        en stage, un plugin Java et une application temps réel. Chaque fiche
        présente le contexte, les besoins, les choix techniques, les opérations
        CRUD, la sécurité et les compétences BTS couvertes.
      </p>
      <p class="legende">
        <a class="lien-externe" href={lien('/e5/')}>Voir le tableau de synthèse E5</a>{' '}
        pour la correspondance avec les six blocs de compétences.
      </p>
    </div>
  </section>

  <div class="conteneur corps">
    <div class="filtres" role="group" aria-label="Filtrer les réalisations">
      {
        categoriesFiltre.map((categorie) => (
          <button
            type="button"
            data-filtre-projets={categorie.id}
            aria-pressed={categorie.id === 'tous' ? 'true' : 'false'}
          >
            {categorie.label}
            <span>{compteurs[categorie.id] ?? 0}</span>
          </button>
        ))
      }
    </div>

    <div class="grille" data-grille-projets>
      {
        realisations.map((projet) => (
          <div class="projet-item" data-projet-item data-categorie={projet.data.contexte}>
            <CarteProjet projet={projet} />
          </div>
        ))
      }
    </div>

    <section class="autres" id="autres">
      <div class="entete-section">
        <div>
          <span class="surtitre">Autres travaux</span>
          <h2>Réalisations complémentaires</h2>
        </div>
        <p class="legende">
          Projets de cours, expérimentations et deuxièmes stages : utiles pour
          montrer la progression, mais hors tableau de synthèse E5.
        </p>
      </div>

      <div class="grille">
        {autres.map((projet) => <CarteProjet projet={projet} compact />)}
      </div>
    </section>
  </div>
</Base>

<style>
  .entete-page {
    padding-block: clamp(3rem, 8vw, 5rem) clamp(1.5rem, 4vw, 2.5rem);
  }

  .entete-page h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.035em;
  }

  .entete-page .legende {
    max-width: 68ch;
    margin-top: 1rem;
  }

  .corps {
    padding-bottom: 4rem;
  }

  .filtres {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
  }

  .filtres button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.38rem 0.7rem;
    font-family: var(--police);
    font-size: 0.82rem;
    color: var(--texte-2);
    background: var(--fond-2);
    border: 1px solid var(--bordure);
    border-radius: var(--r-s);
    cursor: pointer;
    transition: color var(--transition), border-color var(--transition), background var(--transition);
  }

  .filtres button span {
    font-family: var(--police-mono);
    font-size: 0.68rem;
    color: var(--texte-3);
  }

  .filtres button:hover {
    color: var(--texte);
    border-color: var(--bordure-forte);
  }

  .filtres button[aria-pressed='true'] {
    color: #ffffff;
    background: var(--accent-fort);
    border-color: var(--accent-fort);
  }

  .filtres button[aria-pressed='true'] span {
    color: rgb(255 255 255 / 0.75);
  }

  .grille {
    grid-template-columns: 1fr;
  }

  @media (min-width: 48rem) {
    .grille {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .projet-item[hidden] {
    display: none !important;
  }

  .autres .grille {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
  }

  .autres {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--bordure);
  }
</style>

<script>
  const boutons = document.querySelectorAll<HTMLButtonElement>('[data-filtre-projets]');
  const items = document.querySelectorAll<HTMLElement>('[data-projet-item]');

  function appliquerFiltre(filtre: string) {
    for (const item of items) {
      item.hidden = filtre !== 'tous' && item.dataset.categorie !== filtre;
    }
    for (const bouton of boutons) {
      bouton.setAttribute('aria-pressed', String(bouton.dataset.filtreProjets === filtre));
    }
  }

  for (const bouton of boutons) {
    bouton.addEventListener('click', () => appliquerFiltre(bouton.dataset.filtreProjets ?? 'tous'));
  }
</script>
